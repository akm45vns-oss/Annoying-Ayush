# ==============================================================================
# Annoying Ayush — Server-Side AI Environment Variables (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Add your chosen key to Vercel Project Settings > Environment Variables for production.
# 3. NEVER commit real API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# FREE OPTION 1: Groq Cloud (Recommended — Ultra-fast & 100% Free Tier, No Card)
# Get a free API key in 30 seconds at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional model override (defaults to llama-3.3-70b-versatile, or llama-3.1-8b-instant):
# GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# FREE OPTION 2: Google Gemini via Google AI Studio (100% Free Tier, No Card)
# Get a free API key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-1.5-flash):
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# FREE OPTION 3: OpenRouter (Has Free Models like :free)
# Get a free key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# OPTION 4: OpenAI API (Paid / Pay-as-you-go)
# Get a key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
