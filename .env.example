# ==============================================================================
# Annoying Ayush — Server-Side AI Environment Variables (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Add your chosen key to Vercel Project Settings > Environment Variables for production.
# 3. NEVER commit real API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# MULTI-TIER RESILIENCE: You can configure BOTH Groq and Gemini!
# If both keys are provided, Groq is used as the ultra-fast primary tier,
# and Google Gemini automatically takes over if Groq hits rate limits or downtime.
# If both ever fail, the smart pre-programmed offline engine responds instantly.
# ------------------------------------------------------------------------------

# FREE OPTION 1: Groq Cloud (Ultra-fast & 100% Free Tier, No Card)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional model override (defaults to qwen/qwen3.8-27b or llama-3.3-70b-versatile):
# GROQ_MODEL=qwen/qwen3.8-27b

# FREE OPTION 2: Google Gemini via Google AI Studio (100% Free Tier, No Card)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-flash-latest):
# GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# FREE OPTION 3: OpenRouter (Has Free Models like :free)
# Get a free key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# OPTION 4: OpenAI API (Paid / Pay-as-you-go)
# Get a key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
