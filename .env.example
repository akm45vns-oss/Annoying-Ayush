# ==============================================================================
# Annoying Ayush — Server-Side AI Environment Variables (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Add your secret key to Vercel Project Settings > Environment Variables for production.
# 3. NEVER commit real API keys to Git.
# ==============================================================================

# Option 1: Groq API (Ultra-fast & free tier available!)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional model override (defaults to llama-3.3-70b-versatile):
# Recommended models:
# - llama-3.3-70b-versatile (High intelligence, rich personality)
# - llama-3.1-8b-instant (Instantaneous response speed)
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini API
# Get a key at: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-1.5-flash):
# GEMINI_MODEL=gemini-1.5-flash

# Option 3: OpenAI API
# Get a key at: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here
# Optional model override (defaults to gpt-4o-mini):
# OPENAI_MODEL=gpt-4o-mini
# Optional base URL override (for OpenRouter, custom proxy):
# OPENAI_BASE_URL=https://api.openai.com/v1
