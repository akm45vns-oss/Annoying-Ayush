# ==============================================================================
# Annoying Ayush — Server-Side AI Environment Variables (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Add your chosen key to Vercel Project Settings > Environment Variables for production.
# 3. NEVER commit real API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# MULTI-TIER RESILIENCE: You can configure BOTH Groq and Gemini!
# If both keys are provided, Groq is used as the ultra-fast primary tier,
# and Google Gemini automatically takes over if Groq hits rate limits or downtime.
# If both ever fail, the smart pre-programmed offline engine responds instantly.
# ------------------------------------------------------------------------------

# FREE OPTION 1: Groq Cloud (Ultra-fast & 100% Free Tier, No Card)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional model override (defaults to qwen/qwen3.8-27b or llama-3.3-70b-versatile):
# GROQ_MODEL=qwen/qwen3.8-27b

# FREE OPTION 2: Google Gemini via Google AI Studio (100% Free Tier, No Card)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-flash-latest):
# GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# FREE OPTION 3: OpenRouter (Has Free Models like :free)
# Get a free key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# OPTION 4: OpenAI API (Paid / Pay-as-you-go)
# Get a key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# AUTHORIZED CUSTOM VOICE CLONING (ElevenLabs — Instant Voice Clone)
# 
# How to create and connect your own voice:
# 1. Sign up / Log in at https://elevenlabs.io/
# 2. Go to VoiceLab (https://elevenlabs.io/app/voice-lab) > "Add Generative or Cloned Voice" > "Instant Voice Clone"
# 3. Record or upload 1 to 3 minutes of clear, clean audio of your voice without background noise
#    (e.g., reading a romantic poem or conversational sentences in your normal tone)
# 4. Name the voice "Ayush" and click "Save"
# 5. Click the "ID" copy icon next to your new voice to get your ELEVENLABS_VOICE_ID
# 6. Go to your Profile > API Keys (https://elevenlabs.io/app/api-keys) to create/copy ELEVENLABS_API_KEY
# 7. Add both variables to:
#    - Local development: .env.local
#    - Production: Vercel Dashboard > Project Settings > Environment Variables
#
# Supported Languages:
# - Model eleven_multilingual_v2 supports 29 languages including Hindi (Devanagari),
#   English, and bilingual Hinglish.
# - Bhojpuri phrases written in Devanagari script are read phonetically using the
#   underlying Indo-Aryan phonetics model.
# ==============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

