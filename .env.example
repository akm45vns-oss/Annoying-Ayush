# ==============================================================================
# Annoying Ayush — Server-Side AI Environment Variables (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development.
# 2. Add your secret key to Vercel Project Settings > Environment Variables for production.
# 3. NEVER commit real API keys to Git.
# ==============================================================================

# Option 1: Google Gemini API (Recommended)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI API (Alternative)
# Get a key at: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here
# Optional model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional base URL override (for OpenRouter, Groq, or proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
